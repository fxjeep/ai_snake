<ui:FluentWindow x:Class="TaskNotesWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:TaskNotesWpf.ViewModels"
        mc:Ignorable="d"
        Title="Task Notes" Height="640" Width="460"
        Icon="app.ico"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">
    <ui:FluentWindow.DataContext>
        <vm:MainViewModel />
    </ui:FluentWindow.DataContext>
    <DockPanel>
        <ui:TitleBar Title="Task Notes" DockPanel.Dock="Top">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid DockPanel.Dock="Top" Margin="20,10,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Tasks" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <CheckBox Grid.Column="1" Content="Show Completed" IsChecked="{Binding ShowCompleted}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ui:Button Grid.Column="2" Command="{Binding AddTaskCommand}" Width="34" Height="34" Padding="0" ToolTip="Add task" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Add24" FontSize="16" />
            </ui:Button>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,12,20,20">
            <ItemsControl ItemsSource="{Binding VisibleTasks}" HorizontalContentAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,10" Padding="8" Opacity="{Binding Opacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Width="100" VerticalAlignment="Center" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}" />
                                <Button Grid.Column="1" Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Margin="10,0,6,0" Cursor="Hand">
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                </Button>
                                <ui:Button Grid.Column="2" x:Name="TaskActionsButton" Width="30" Height="30" Padding="0" Background="Transparent" ToolTip="Actions" Click="TaskActionsButton_Click" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="MoreVertical24" FontSize="16" />
                                    <ui:Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="View" Click="TaskMenuView_Click" />
                                            <MenuItem Header="Delete" Click="TaskMenuDelete_Click" />
                                        </ContextMenu>
                                    </ui:Button.ContextMenu>
                                </ui:Button>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</ui:FluentWindow>
